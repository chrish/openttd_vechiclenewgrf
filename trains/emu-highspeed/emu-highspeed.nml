item(FEAT_TRAINS, item_quantum_qr_omega, 2446) {
    property {
        name:                           string(STR_QUANTUM_QR_OMEGA_NAME);
        climates_available:             bitmask(CLIMATE_TEMPERATE);
        introduction_date:              date(2060, 1, 1);
        model_life:                     30;
        vehicle_life:                   40;
        reliability_decay:              14;
        cost_factor:                    255;
        running_cost_factor:            255;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        track_type:                     ELRL;
        speed:                          1000 km/h;
        power:                          60000 hp;
        weight:                         350 ton;
        tractive_effort_coefficient:    0.35;
        loading_speed:                  15;
        cargo_age_period:               462;
    }
}
