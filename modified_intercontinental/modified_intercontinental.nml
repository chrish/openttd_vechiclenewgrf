/**
 * modified_intercontinental.nml
 *
 * NewGRF that overrides the Intercontinental Airport with a modified layout:
 *   - Shorter runways (6 tiles instead of 8)
 *   - Freed tiles converted to taxi holding bays (apron tiles)
 *   - Same 9×11 footprint, 8 terminals, 2 helipads, 2 hangars
 *   - Reduced noise level (20 instead of 25)
 *
 * Original intercontinental layout from airport_defaults.h.
 * Default base-set graphics are reused — no custom sprite sheet required.
 */

grf {
    grfid: "CA\02\01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 1;
    min_compatible_version: 1;
}

/* ==================================================================
 * Airport tile IDs (local to this GRF, 0..255)
 *
 * We define tiles that substitute the default airport tiles used in
 * the intercontinental layout.  Each tile just reuses the default
 * graphics via the "substitute" property.
 *
 * Default tile enum IDs from airporttile_ids.h:
 *   0  APT_APRON                 48 APT_APRON_FENCE_NE
 *  15  APT_RUNWAY_2              50 APT_RUNWAY_FENCE_NW
 *  24  APT_DEPOT_SE              52 APT_RADAR_FENCE_NE
 *  25  APT_STAND_1               55 APT_HELIPAD_2
 *  29  APT_EMPTY                 56 APT_APRON_FENCE_NE_SW
 *  32  APT_RADIO_TOWER_FENCE_NE  57 APT_RUNWAY_END_FENCE_NW_SW
 *  47  APT_TOWER                 58 APT_RUNWAY_END_FENCE_SE_SW
 *  etc.                          59 APT_RUNWAY_END_FENCE_NE_NW
 *                                60 APT_RUNWAY_END_FENCE_NE_SE
 *                                65 APT_APRON_FENCE_SE
 *                                62 APT_APRON_FENCE_SE_SW
 *                                69 APT_LOW_BUILDING
 *                                70 APT_APRON_FENCE_NE_SE
 *                                71 APT_APRON_HALF_EAST
 *                                72 APT_APRON_HALF_WEST
 *                                73 APT_GRASS_FENCE_NE_FLAG_2
 *   2  APT_APRON_FENCE_SW        21 APT_ROUND_TERMINAL
 *  19  APT_BUILDING_2            22 APT_BUILDING_3
 *  23  APT_BUILDING_1             1 APT_APRON_FENCE_NW
 *   3  APT_STAND                 12 APT_APRON_HOR
 * ================================================================== */

/* --- Tile definitions ------------------------------------------------
 * Each tile substitutes a default airport tile so it inherits the
 * original graphics.  We only need enough unique tile items to cover
 * every distinct default tile used in our layout.
 * ------------------------------------------------------------------ */

item(FEAT_AIRPORTTILES, tile_apron, 0) {
    property { substitute: 0; /* APT_APRON */ }
}
item(FEAT_AIRPORTTILES, tile_apron_fence_nw, 1) {
    property { substitute: 1; /* APT_APRON_FENCE_NW */ }
}
item(FEAT_AIRPORTTILES, tile_apron_fence_sw, 2) {
    property { substitute: 2; /* APT_APRON_FENCE_SW */ }
}
item(FEAT_AIRPORTTILES, tile_stand, 3) {
    property { substitute: 3; /* APT_STAND */ }
}
item(FEAT_AIRPORTTILES, tile_apron_hor, 4) {
    property { substitute: 12; /* APT_APRON_HOR */ }
}
item(FEAT_AIRPORTTILES, tile_runway_2, 5) {
    property { substitute: 15; /* APT_RUNWAY_2 */ }
}
item(FEAT_AIRPORTTILES, tile_building_2, 6) {
    property { substitute: 19; /* APT_BUILDING_2 */ }
}
item(FEAT_AIRPORTTILES, tile_round_terminal, 7) {
    property { substitute: 21; /* APT_ROUND_TERMINAL */ }
}
item(FEAT_AIRPORTTILES, tile_building_3, 8) {
    property { substitute: 22; /* APT_BUILDING_3 */ }
}
item(FEAT_AIRPORTTILES, tile_building_1, 9) {
    property { substitute: 23; /* APT_BUILDING_1 */ }
}
item(FEAT_AIRPORTTILES, tile_depot_se, 10) {
    property { substitute: 24; /* APT_DEPOT_SE */ }
}
item(FEAT_AIRPORTTILES, tile_empty, 11) {
    property { substitute: 29; /* APT_EMPTY */ }
}
item(FEAT_AIRPORTTILES, tile_radio_tower_fence_ne, 12) {
    property { substitute: 32; /* APT_RADIO_TOWER_FENCE_NE */ }
}
item(FEAT_AIRPORTTILES, tile_tower, 13) {
    property { substitute: 47; /* APT_TOWER */ }
}
item(FEAT_AIRPORTTILES, tile_apron_fence_ne, 14) {
    property { substitute: 48; /* APT_APRON_FENCE_NE */ }
}
item(FEAT_AIRPORTTILES, tile_runway_fence_nw, 15) {
    property { substitute: 50; /* APT_RUNWAY_FENCE_NW */ }
}
item(FEAT_AIRPORTTILES, tile_radar_fence_ne, 16) {
    property { substitute: 52; /* APT_RADAR_FENCE_NE */ }
}
item(FEAT_AIRPORTTILES, tile_helipad_2, 17) {
    property { substitute: 55; /* APT_HELIPAD_2 */ }
}
item(FEAT_AIRPORTTILES, tile_apron_fence_ne_sw, 18) {
    property { substitute: 56; /* APT_APRON_FENCE_NE_SW */ }
}
item(FEAT_AIRPORTTILES, tile_runway_end_fence_nw_sw, 19) {
    property { substitute: 57; /* APT_RUNWAY_END_FENCE_NW_SW */ }
}
item(FEAT_AIRPORTTILES, tile_runway_end_fence_se_sw, 20) {
    property { substitute: 58; /* APT_RUNWAY_END_FENCE_SE_SW */ }
}
item(FEAT_AIRPORTTILES, tile_runway_end_fence_ne_nw, 21) {
    property { substitute: 59; /* APT_RUNWAY_END_FENCE_NE_NW */ }
}
item(FEAT_AIRPORTTILES, tile_runway_end_fence_ne_se, 22) {
    property { substitute: 60; /* APT_RUNWAY_END_FENCE_NE_SE */ }
}
item(FEAT_AIRPORTTILES, tile_apron_fence_se_sw, 23) {
    property { substitute: 62; /* APT_APRON_FENCE_SE_SW */ }
}
item(FEAT_AIRPORTTILES, tile_apron_fence_se, 24) {
    property { substitute: 65; /* APT_APRON_FENCE_SE */ }
}
item(FEAT_AIRPORTTILES, tile_low_building, 25) {
    property { substitute: 69; /* APT_LOW_BUILDING */ }
}
item(FEAT_AIRPORTTILES, tile_apron_fence_ne_se, 26) {
    property { substitute: 70; /* APT_APRON_FENCE_NE_SE */ }
}
item(FEAT_AIRPORTTILES, tile_apron_half_east, 27) {
    property { substitute: 71; /* APT_APRON_HALF_EAST */ }
}
item(FEAT_AIRPORTTILES, tile_apron_half_west, 28) {
    property { substitute: 72; /* APT_APRON_HALF_WEST */ }
}
item(FEAT_AIRPORTTILES, tile_grass_fence_ne_flag_2, 29) {
    property { substitute: 73; /* APT_GRASS_FENCE_NE_FLAG_2 */ }
}


/* ==================================================================
 * Tile layout for the Modified Intercontinental Airport (9×11)
 *
 * ORIGINAL intercontinental layout (from airport_defaults.h):
 *
 *       Col: 0       1       2       3       4       5       6       7       8
 * Row 0:  RADAR   RW_END  RW_FNC  RW_FNC  RW_FNC  RW_FNC  RW_FNC  RW_FNC  RW_END
 * Row 1:  RW_END  RW_2    RW_2    RW_2    RW_2    RW_2    RW_2    RW_END  APRON
 * Row 2:  APRON   EMPTY   APRON   APRON   APRON   APRON   APRON   RADIO   APRON
 * Row 3:  APRON   HALF_E  APRON   TOWER   HELI2   HELI2   APRON   APR_NW  APR_SW
 * Row 4:  APRON   APRON   APRON   STAND   BLDG1   STAND   APRON   LOWBLD  DEPOT
 * Row 5:  DEPOT   LOWBLD  APRON   STAND   BLDG2   STAND   APRON   APRON   APR_SW
 * Row 6:  APRON   APRON   APRON   STAND   BLDG3   STAND   APRON   APRON   APR_SW
 * Row 7:  APRON   APR_SE  APRON   STAND   ROUND   STAND   APR_SW  HALF_W  APR_SW
 * Row 8:  APRON   GRASS   APRON   APRON   APRON   APRON   APR_SW  EMPTY   APRON
 * Row 9:  APRON   RW_END  RW_FNC  RW_FNC  RW_FNC  RW_FNC  RW_FNC  RW_FNC  RW_END
 * Row10:  RW_END  RW_2    RW_2    RW_2    RW_2    RW_2    RW_2    RW_END  EMPTY
 *
 * MODIFIED layout — shorten each runway by 2 tiles (1 from each end),
 * converting the freed endpoint tiles to apron (taxi holding bays):
 *
 *       Col: 0       1       2       3       4       5       6       7       8
 * Row 0:  RADAR   [HOLD]  RW_END  RW_FNC  RW_FNC  RW_FNC  RW_FNC  RW_END  [HOLD]
 * Row 1:  [HOLD]  RW_END  RW_2    RW_2    RW_2    RW_2    RW_END  [HOLD]  APRON
 * Row 2:  APRON   EMPTY   APRON   APRON   APRON   APRON   APRON   RADIO   APRON
 * Row 3:  APRON   HALF_E  APRON   TOWER   HELI2   HELI2   APRON   APR_NW  APR_SW
 * Row 4:  APRON   APRON   APRON   STAND   BLDG1   STAND   APRON   LOWBLD  DEPOT
 * Row 5:  DEPOT   LOWBLD  APRON   STAND   BLDG2   STAND   APRON   APRON   APR_SW
 * Row 6:  APRON   APRON   APRON   STAND   BLDG3   STAND   APRON   APRON   APR_SW
 * Row 7:  APRON   APR_SE  APRON   STAND   ROUND   STAND   APR_SW  HALF_W  APR_SW
 * Row 8:  APRON   GRASS   APRON   APRON   APRON   APRON   APR_SW  EMPTY   APRON
 * Row 9:  APRON   [HOLD]  RW_END  RW_FNC  RW_FNC  RW_FNC  RW_FNC  RW_END  [HOLD]
 * Row10:  [HOLD]  RW_END  RW_2    RW_2    RW_2    RW_2    RW_END  [HOLD]  EMPTY
 *
 * [HOLD] = taxi holding bay = apron tile
 * ================================================================== */

tilelayout airport_layout_modified_intercontinental {
    rotation: DIRECTION_NORTH;

    /* Row 0: Top runway out (shortened) — col 1 & 8 become holding bays */
    0, 0:   tile_radar_fence_ne;
    1, 0:   tile_apron_fence_ne;         /* was RUNWAY_END — now holding bay */
    2, 0:   tile_runway_end_fence_ne_nw; /* runway start */
    3, 0:   tile_runway_fence_nw;
    4, 0:   tile_runway_fence_nw;
    5, 0:   tile_runway_fence_nw;
    6, 0:   tile_runway_fence_nw;
    7, 0:   tile_runway_end_fence_nw_sw; /* runway end */
    8, 0:   tile_apron_fence_ne_sw;      /* was RUNWAY_END — now holding bay */

    /* Row 1: Top runway in (shortened) — col 0 & 7 become holding bays */
    0, 1:   tile_apron_fence_ne_sw;      /* was RUNWAY_END — now holding bay */
    1, 1:   tile_runway_end_fence_ne_nw; /* runway start */
    2, 1:   tile_runway_2;
    3, 1:   tile_runway_2;
    4, 1:   tile_runway_2;
    5, 1:   tile_runway_2;
    6, 1:   tile_runway_end_fence_se_sw; /* runway end */
    7, 1:   tile_apron_fence_ne_sw;      /* was RUNWAY_END — now holding bay */
    8, 1:   tile_apron_fence_ne_sw;

    /* Row 2: Transition / taxiway (unchanged) */
    0, 2:   tile_apron_fence_ne_sw;
    1, 2:   tile_empty;
    2, 2:   tile_apron_fence_ne;
    3, 2:   tile_apron;
    4, 2:   tile_apron;
    5, 2:   tile_apron;
    6, 2:   tile_apron;
    7, 2:   tile_radio_tower_fence_ne;
    8, 2:   tile_apron_fence_ne_sw;

    /* Row 3: Helipads + tower (unchanged) */
    0, 3:   tile_apron_fence_ne;
    1, 3:   tile_apron_half_east;
    2, 3:   tile_apron_fence_ne;
    3, 3:   tile_tower;
    4, 3:   tile_helipad_2;
    5, 3:   tile_helipad_2;
    6, 3:   tile_apron;
    7, 3:   tile_apron_fence_nw;
    8, 3:   tile_apron_fence_sw;

    /* Row 4: Terminals 3,1,5 + hangar 2 (unchanged) */
    0, 4:   tile_apron_fence_ne;
    1, 4:   tile_apron;
    2, 4:   tile_apron;
    3, 4:   tile_stand;
    4, 4:   tile_building_1;
    5, 4:   tile_stand;
    6, 4:   tile_apron;
    7, 4:   tile_low_building;
    8, 4:   tile_depot_se;  /* hangar 2 */

    /* Row 5: Terminals 2,6 + hangar 1 (unchanged) */
    0, 5:   tile_depot_se;  /* hangar 1 */
    1, 5:   tile_low_building;
    2, 5:   tile_apron;
    3, 5:   tile_stand;
    4, 5:   tile_building_2;
    5, 5:   tile_stand;
    6, 5:   tile_apron;
    7, 5:   tile_apron;
    8, 5:   tile_apron_fence_sw;

    /* Row 6: Terminals 3,7 (unchanged) */
    0, 6:   tile_apron_fence_ne;
    1, 6:   tile_apron;
    2, 6:   tile_apron;
    3, 6:   tile_stand;
    4, 6:   tile_building_3;
    5, 6:   tile_stand;
    6, 6:   tile_apron;
    7, 6:   tile_apron;
    8, 6:   tile_apron_fence_sw;

    /* Row 7: Terminals 4,8 (unchanged) */
    0, 7:   tile_apron_fence_ne;
    1, 7:   tile_apron_fence_se;
    2, 7:   tile_apron;
    3, 7:   tile_stand;
    4, 7:   tile_round_terminal;
    5, 7:   tile_stand;
    6, 7:   tile_apron_fence_sw;
    7, 7:   tile_apron_half_west;
    8, 7:   tile_apron_fence_sw;

    /* Row 8: Transition / taxiway (unchanged) */
    0, 8:   tile_apron_fence_ne;
    1, 8:   tile_grass_fence_ne_flag_2;
    2, 8:   tile_apron_fence_ne;
    3, 8:   tile_apron;
    4, 8:   tile_apron;
    5, 8:   tile_apron;
    6, 8:   tile_apron_fence_sw;
    7, 8:   tile_empty;
    8, 8:   tile_apron_fence_ne_sw;

    /* Row 9: Bottom runway out (shortened) — col 1 & 8 become holding bays */
    0, 9:   tile_apron_fence_ne;
    1, 9:   tile_apron_fence_ne;         /* was RUNWAY_END — now holding bay */
    2, 9:   tile_runway_end_fence_ne_nw; /* runway start */
    3, 9:   tile_runway_fence_nw;
    4, 9:   tile_runway_fence_nw;
    5, 9:   tile_runway_fence_nw;
    6, 9:   tile_runway_fence_nw;
    7, 9:   tile_runway_end_fence_se_sw; /* runway end */
    8, 9:   tile_apron_fence_ne_sw;      /* was RUNWAY_END — now holding bay */

    /* Row 10: Bottom runway in (shortened) — col 0 & 7 become holding bays */
    0, 10:  tile_apron_fence_ne_sw;      /* was RUNWAY_END — now holding bay */
    1, 10:  tile_runway_end_fence_ne_nw; /* runway start -- note: visually was NE_SE end */
    2, 10:  tile_runway_2;
    3, 10:  tile_runway_2;
    4, 10:  tile_runway_2;
    5, 10:  tile_runway_2;
    6, 10:  tile_runway_end_fence_se_sw; /* runway end */
    7, 10:  tile_apron_fence_ne_sw;      /* was RUNWAY_END — now holding bay */
    8, 10:  tile_empty;
}


/* ==================================================================
 * Original Intercontinental layout (faithful reproduction)
 * ================================================================== */

tilelayout airport_layout_original_intercontinental {
    rotation: DIRECTION_NORTH;

    /* Row 0 */
    0, 0:   tile_radar_fence_ne;
    1, 0:   tile_runway_end_fence_ne_nw;
    2, 0:   tile_runway_fence_nw;
    3, 0:   tile_runway_fence_nw;
    4, 0:   tile_runway_fence_nw;
    5, 0:   tile_runway_fence_nw;
    6, 0:   tile_runway_fence_nw;
    7, 0:   tile_runway_fence_nw;
    8, 0:   tile_runway_end_fence_nw_sw;

    /* Row 1 */
    0, 1:   tile_runway_end_fence_ne_nw;
    1, 1:   tile_runway_2;
    2, 1:   tile_runway_2;
    3, 1:   tile_runway_2;
    4, 1:   tile_runway_2;
    5, 1:   tile_runway_2;
    6, 1:   tile_runway_2;
    7, 1:   tile_runway_end_fence_se_sw;
    8, 1:   tile_apron_fence_ne_sw;

    /* Row 2 */
    0, 2:   tile_apron_fence_ne_sw;
    1, 2:   tile_empty;
    2, 2:   tile_apron_fence_ne;
    3, 2:   tile_apron;
    4, 2:   tile_apron;
    5, 2:   tile_apron;
    6, 2:   tile_apron;
    7, 2:   tile_radio_tower_fence_ne;
    8, 2:   tile_apron_fence_ne_sw;

    /* Row 3 */
    0, 3:   tile_apron_fence_ne;
    1, 3:   tile_apron_half_east;
    2, 3:   tile_apron_fence_ne;
    3, 3:   tile_tower;
    4, 3:   tile_helipad_2;
    5, 3:   tile_helipad_2;
    6, 3:   tile_apron;
    7, 3:   tile_apron_fence_nw;
    8, 3:   tile_apron_fence_sw;

    /* Row 4 */
    0, 4:   tile_apron_fence_ne;
    1, 4:   tile_apron;
    2, 4:   tile_apron;
    3, 4:   tile_stand;
    4, 4:   tile_building_1;
    5, 4:   tile_stand;
    6, 4:   tile_apron;
    7, 4:   tile_low_building;
    8, 4:   tile_depot_se;

    /* Row 5 */
    0, 5:   tile_depot_se;
    1, 5:   tile_low_building;
    2, 5:   tile_apron;
    3, 5:   tile_stand;
    4, 5:   tile_building_2;
    5, 5:   tile_stand;
    6, 5:   tile_apron;
    7, 5:   tile_apron;
    8, 5:   tile_apron_fence_sw;

    /* Row 6 */
    0, 6:   tile_apron_fence_ne;
    1, 6:   tile_apron;
    2, 6:   tile_apron;
    3, 6:   tile_stand;
    4, 6:   tile_building_3;
    5, 6:   tile_stand;
    6, 6:   tile_apron;
    7, 6:   tile_apron;
    8, 6:   tile_apron_fence_sw;

    /* Row 7 */
    0, 7:   tile_apron_fence_ne;
    1, 7:   tile_apron_fence_se;
    2, 7:   tile_apron;
    3, 7:   tile_stand;
    4, 7:   tile_round_terminal;
    5, 7:   tile_stand;
    6, 7:   tile_apron_fence_sw;
    7, 7:   tile_apron_half_west;
    8, 7:   tile_apron_fence_sw;

    /* Row 8 */
    0, 8:   tile_apron_fence_ne;
    1, 8:   tile_grass_fence_ne_flag_2;
    2, 8:   tile_apron_fence_ne;
    3, 8:   tile_apron;
    4, 8:   tile_apron;
    5, 8:   tile_apron;
    6, 8:   tile_apron_fence_sw;
    7, 8:   tile_empty;
    8, 8:   tile_apron_fence_ne_sw;

    /* Row 9 */
    0, 9:   tile_apron_fence_ne;
    1, 9:   tile_runway_end_fence_ne_nw;
    2, 9:   tile_runway_fence_nw;
    3, 9:   tile_runway_fence_nw;
    4, 9:   tile_runway_fence_nw;
    5, 9:   tile_runway_fence_nw;
    6, 9:   tile_runway_fence_nw;
    7, 9:   tile_runway_fence_nw;
    8, 9:   tile_runway_end_fence_se_sw;

    /* Row 10 */
    0, 10:  tile_runway_end_fence_ne_se;
    1, 10:  tile_runway_2;
    2, 10:  tile_runway_2;
    3, 10:  tile_runway_2;
    4, 10:  tile_runway_2;
    5, 10:  tile_runway_2;
    6, 10:  tile_runway_2;
    7, 10:  tile_runway_end_fence_se_sw;
    8, 10:  tile_empty;
}


/* ==================================================================
 * Layout name switch — tells the player which layout is selected
 * ================================================================== */

switch(FEAT_AIRPORTS, SELF, sw_layout_name, layout) {
    0: return string(STR_LAYOUT_ORIGINAL);
    1: return string(STR_LAYOUT_MODIFIED);
}


/* ==================================================================
 * Airport item — overrides AT_INTERCONTINENTAL (ID 7)
 * Two layouts: Original (full runways) and Modified (short runways)
 * ================================================================== */

item(FEAT_AIRPORTS, mod_intercontinental, 0) {
    property {
        override: 7; /* AT_INTERCONTINENTAL */
        layouts: [airport_layout_original_intercontinental, airport_layout_modified_intercontinental];
        name: string(STR_AIRPORT_NAME);
        years_available: [2002, 0xFFFF];
        ttd_airport_type: 0; /* ATP_TTDP_LARGE */
        catchment_area: 10;
        noise_level: 25;
        maintenance_cost: 72;
    }
    graphics {
        additional_text: string(STR_AIRPORT_ADDTEXT);
        layout_name: sw_layout_name;
    }
}
