/**
 * early_airliners.nml
 *
 * Pre-WW1 and WW1-era conversion aircraft (1914–1919).
 * Vehicles 1–10 from the master checklist.
 *
 * These are all very early, small aircraft — pioneers and converted
 * WW1 bombers pressed into civilian airliner service.
 * All use AIRCRAFT_TYPE_SMALL (can land on any runway airport).
 */

/* ------------------------------------------------------------------ */
/*  #1  Benoist XIV (1914)                                            */
/*  Flying boat — first scheduled airline service. 1 pax, 105 km/h   */
/* ------------------------------------------------------------------ */

item(FEAT_AIRCRAFT, item_benoist_xiv, 1000) {
    property {
        name:                   string(STR_BENOIST_XIV_NAME);
        climates_available:     bitmask(CLIMATE_TEMPERATE);
        introduction_date:      date(1914, 1, 1);
        model_life:             15;
        vehicle_life:           15;
        reliability_decay:      35;
        cost_factor:            2;
        running_cost_factor:    30;
        aircraft_type:          AIRCRAFT_TYPE_SMALL;
        acceleration:           18;
        speed:                  105 km/h;
        passenger_capacity:     1;
        mail_capacity:          1;
        loading_speed:          1;
        cargo_age_period:       139;
        refittable_cargo_classes:     bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: bitmask();
    }
}

