/**
 * test_milnes_daimler.nml
 *
 * Standalone test NewGRF for the Milnes-Daimler Double-Decker bus
 * with custom 32bpp sprites.
 */

grf {
    grfid: "CT\01\01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 1;
    min_compatible_version: 1;
}


// ---------------------------------------------------------------------------
// Sprite templates (inlined from sprites/templates.nml)
// ---------------------------------------------------------------------------

template tmpl_zoom(x, y, w, h, ox, oy, zoom) {
    [x * zoom, y * zoom, w * zoom, h * zoom, ox * zoom, oy * zoom - (zoom / 2)]
}

template tmpl_road_train(row, zoom) {
    tmpl_zoom(  0, row * 20,  8, 18,  -3, -10, zoom)  // N
    tmpl_zoom( 16, row * 20, 20, 19, -14,  -5, zoom)  // NE
    tmpl_zoom( 48, row * 20, 28, 15, -14,  -8, zoom)  // E
    tmpl_zoom( 96, row * 20, 20, 19,  -6,  -7, zoom)  // SE
    tmpl_zoom(128, row * 20,  8, 18,  -3, -10, zoom)  // S
    tmpl_zoom(144, row * 20, 20, 19, -14,  -9, zoom)  // SW
    tmpl_zoom(176, row * 20, 28, 15, -14,  -8, zoom)  // W
    tmpl_zoom(224, row * 20, 20, 19,  -6,  -7, zoom)  // NW
}


// ---------------------------------------------------------------------------
// Spritesets — 8bpp fallback + 32bpp at 1x and 4x zoom
// ---------------------------------------------------------------------------

// Base spriteset (8bpp palette fallback)
spriteset(milnes_daimler_set, "sprites/road/milnes_daimler_1x_8bpp.png") {
    tmpl_road_train(0, 1)
}

// 32bpp at normal zoom
alternative_sprites(milnes_daimler_set, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP,
                    "sprites/road/milnes_daimler_1x.png") {
    tmpl_road_train(0, 1)
}

// 32bpp at 4x extra zoom
alternative_sprites(milnes_daimler_set, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP,
                    "sprites/road/milnes_daimler_4x.png") {
    tmpl_road_train(0, 4)
}


// ---------------------------------------------------------------------------
// Vehicle definition
// ---------------------------------------------------------------------------

item(FEAT_ROADVEHS, item_milnes_daimler_double_decker, 1390) {
    property {
        name:                           string(STR_MILNES_DAIMLER_DOUBLE_DECKER_NAME);
        climates_available:             bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC);
        introduction_date:              date(1902, 1, 1);
        model_life:                     15;
        vehicle_life:                   15;
        reliability_decay:              32;
        cost_factor:                    3;
        running_cost_factor:            17;
        speed:                          19 km/h;
        power:                          10 hp;
        weight:                         3 ton;
        tractive_effort_coefficient:    0.3;
        cargo_capacity:                 34;
        loading_speed:                  2;
        cargo_age_period:               139;
        refittable_cargo_classes:       bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes:   bitmask();
    }
    graphics {
        default: milnes_daimler_set;
    }
}
